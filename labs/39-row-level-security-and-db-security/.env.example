# Never real production secrets - these are local-only Docker Compose
# passwords for a lab that only ever runs on localhost. See README
# "Production notes" for how real deployments manage these instead
# (secrets manager, IAM auth, rotated credentials).

POSTGRES_DB=lab39
POSTGRES_PORT=5439
PGWEB_PORT=8439

# --- Four distinct Postgres roles, four distinct connection strings ---
# See README "Setup" ("Bootstrapping order") for why there are four and who
# is allowed to use which one.

# 1. ADMIN - the Postgres docker-bootstrap superuser. Used ONLY to create
#    the other three roles (sql/000-bootstrap-roles.sql, run once by Docker
#    itself) and, in scenario:owner-bypass, to demonstrate that a
#    superuser/BYPASSRLS connection ignores Row-Level Security entirely.
#    Application code and migrations never use this connection string.
POSTGRES_ADMIN_USER=lab39_admin
POSTGRES_ADMIN_PASSWORD=lab39_admin_pw
DATABASE_URL_ADMIN=postgres://lab39_admin:lab39_admin_pw@localhost:5439/lab39

# 2. MIGRATOR - owns every table/function/policy this lab creates (it is
#    the role that runs `pnpm db:migrate`). Has DDL rights (CREATE on
#    schema public) but is NOT a superuser and cannot create other roles.
#    Because it OWNS the tables, it also bypasses RLS by default (see
#    README "Break it" / "Fix it" - this is the real, common
#    misconfiguration this lab demonstrates on purpose, not a mistake in
#    this lab's design).
POSTGRES_MIGRATOR_USER=lab39_migrator
POSTGRES_MIGRATOR_PASSWORD=lab39_migrator_pw
DATABASE_URL_MIGRATOR=postgres://lab39_migrator:lab39_migrator_pw@localhost:5439/lab39
DATABASE_URL=postgres://lab39_migrator:lab39_migrator_pw@localhost:5439/lab39

# 3. APP - the role the (imagined) application server connects as for
#    ordinary request handling: SELECT/INSERT/UPDATE/DELETE on the
#    tenant-scoped tables, nothing else. Not the table owner, so it IS
#    subject to Row-Level Security. This is the role used in the naive-leak
#    and rls-fix scenarios.
POSTGRES_APP_USER=lab39_app
POSTGRES_APP_PASSWORD=lab39_app_pw
DATABASE_URL_APP=postgres://lab39_app:lab39_app_pw@localhost:5439/lab39

# 4. READONLY - a reporting/BI role: SELECT only, no INSERT/UPDATE/DELETE,
#    also subject to Row-Level Security like any other non-owner role.
POSTGRES_READONLY_USER=lab39_readonly
POSTGRES_READONLY_PASSWORD=lab39_readonly_pw
DATABASE_URL_READONLY=postgres://lab39_readonly:lab39_readonly_pw@localhost:5439/lab39

LOG_LEVEL=info
