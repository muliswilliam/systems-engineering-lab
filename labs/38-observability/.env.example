POSTGRES_USER=lab38
POSTGRES_PASSWORD=lab38
POSTGRES_DB=lab38
POSTGRES_PORT=5438
PGWEB_PORT=8438
PROMETHEUS_PORT=9438

DATABASE_URL=postgres://lab38:lab38@localhost:5438/lab38

# The lab's own in-process HTTP service (Node's built-in `http` module, no
# framework - see README "Architecture"). Not run inside Docker Compose, same
# as every other lab's `pnpm dev` - only its dependencies (Postgres, PGweb,
# Prometheus) are containerized.
APP_PORT=4438

LOG_LEVEL=info

# Where scenario/test runs write real structured (ndjson) and naive
# (inconsistent free-text) log files for the log-aggregation scenario to
# read back. Gitignored (*.log), regenerated by every scenario/test run.
STRUCTURED_LOG_FILE=logs/structured.log
NAIVE_LOG_FILE=logs/naive.log
