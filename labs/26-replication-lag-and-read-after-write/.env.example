POSTGRES_USER=postgres
POSTGRES_PASSWORD=lab26
POSTGRES_DB=lab26

REPLICATION_USER=repl_user
REPLICATION_PASSWORD=repl_password

PRIMARY_POSTGRES_PORT=5426
PRIMARY_PGWEB_PORT=8426
REPLICA_POSTGRES_PORT=5526
REPLICA_PGWEB_PORT=8526

# Migrations and all application writes go through PRIMARY_DATABASE_URL only.
PRIMARY_DATABASE_URL=postgres://postgres:lab26@localhost:5426/lab26
# The replica is read-only at the Postgres level, and is also where every
# read-after-write strategy in this lab is actually exercised from.
REPLICA_DATABASE_URL=postgres://postgres:lab26@localhost:5526/lab26

LOG_LEVEL=info
