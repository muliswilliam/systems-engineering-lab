POSTGRES_USER=lab32
POSTGRES_PASSWORD=lab32
POSTGRES_DB=lab32
# 5432 is Postgres's OWN default port. If you already have a local Postgres
# running on your machine (outside Docker), this WILL collide - override
# POSTGRES_PORT (and update DATABASE_URL below to match) before running
# `docker compose up -d`. This lab uses 5432 because it is lab 32's literal
# assigned port under this repository's `54NN` convention (see ROADMAP.md);
# it is not special-cased away from the collision on purpose.
POSTGRES_PORT=5432
PGWEB_PORT=8432

DATABASE_URL=postgres://lab32:lab32@localhost:5432/lab32

LOG_LEVEL=info
