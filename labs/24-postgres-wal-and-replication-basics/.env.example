POSTGRES_USER=postgres
POSTGRES_PASSWORD=lab24
POSTGRES_DB=lab24

REPLICATION_USER=repl_user
REPLICATION_PASSWORD=repl_password

PRIMARY_POSTGRES_PORT=5424
PRIMARY_PGWEB_PORT=8424
REPLICA_POSTGRES_PORT=5524
REPLICA_PGWEB_PORT=8524

# Migrations and all application writes go through PRIMARY_DATABASE_URL only.
PRIMARY_DATABASE_URL=postgres://postgres:lab24@localhost:5424/lab24
# The replica is read-only at the Postgres level - see replica-rejects-writes.ts.
REPLICA_DATABASE_URL=postgres://postgres:lab24@localhost:5524/lab24

LOG_LEVEL=info
