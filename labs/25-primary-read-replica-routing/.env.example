POSTGRES_USER=postgres
POSTGRES_PASSWORD=lab25
POSTGRES_DB=lab25

REPLICATION_USER=repl_user
REPLICATION_PASSWORD=repl_password

PRIMARY_POSTGRES_PORT=5425
PRIMARY_PGWEB_PORT=8425
REPLICA_POSTGRES_PORT=5525
REPLICA_PGWEB_PORT=8525

# Migrations and every WRITE go through PRIMARY_DATABASE_URL. This is the
# only connection string the router is ever allowed to use for writes,
# read-after-write reads, and transactions.
PRIMARY_DATABASE_URL=postgres://postgres:lab25@localhost:5425/lab25
# Ordinary reads are routed here by the corrected router. The replica is
# read-only at the Postgres level (see Lab 24) - the router routes reads
# here deliberately to offload the primary, not because writes would fail
# silently if sent here by mistake.
REPLICA_DATABASE_URL=postgres://postgres:lab25@localhost:5525/lab25

LOG_LEVEL=info
