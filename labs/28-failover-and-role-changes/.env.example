POSTGRES_USER=postgres
POSTGRES_PASSWORD=lab28
POSTGRES_DB=lab28

REPLICATION_USER=repl_user
REPLICATION_PASSWORD=repl_password

PRIMARY_POSTGRES_PORT=5428
PRIMARY_PGWEB_PORT=8428
REPLICA_POSTGRES_PORT=5528
REPLICA_PGWEB_PORT=8528

# Migrations and all NORMAL application writes go through PRIMARY_DATABASE_URL.
PRIMARY_DATABASE_URL=postgres://postgres:lab28@localhost:5428/lab28
# Before failover this is a read-only standby (SQLSTATE 25006 on write). After
# this lab's failover scenario calls pg_promote() against it, the SAME
# connection string becomes a genuine, independent, writable primary - see
# src/scenarios/failover-and-promote.ts.
REPLICA_DATABASE_URL=postgres://postgres:lab28@localhost:5528/lab28

LOG_LEVEL=info
