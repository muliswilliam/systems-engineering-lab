POSTGRES_USER=postgres
POSTGRES_PASSWORD=lab27
POSTGRES_DB=lab27

REPLICATION_USER=repl_user
REPLICATION_PASSWORD=repl_password

PRIMARY_POSTGRES_PORT=5427
PRIMARY_PGWEB_PORT=8427
REPLICA1_POSTGRES_PORT=5527
REPLICA1_PGWEB_PORT=8527
REPLICA2_POSTGRES_PORT=5627
REPLICA2_PGWEB_PORT=8627

# Migrations and all application writes go through PRIMARY_DATABASE_URL only.
PRIMARY_DATABASE_URL=postgres://postgres:lab27@localhost:5427/lab27
# replica-1 streams directly from the primary (the first hop of the cascade).
REPLICA1_DATABASE_URL=postgres://postgres:lab27@localhost:5527/lab27
# replica-2 streams from REPLICA-1, not from the primary - see
# docker-compose.yml and README.md "Architecture".
REPLICA2_DATABASE_URL=postgres://postgres:lab27@localhost:5627/lab27

LOG_LEVEL=info
