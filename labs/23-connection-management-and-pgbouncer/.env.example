POSTGRES_USER=lab23
POSTGRES_PASSWORD=lab23
POSTGRES_DB=lab23
POSTGRES_PORT=5423
PGWEB_PORT=8423

# PgBouncer's own pool_mode is a single setting per pgbouncer.ini/instance, so
# comparing session pooling against transaction pooling side by side means
# running two separate PgBouncer instances against the same Postgres - see
# README "Architecture" for why. New port convention introduced by this lab:
# 63NN for PgBouncer, alongside the existing 54NN (Postgres) / 84NN (PGweb)
# convention from ROADMAP.md.
PGBOUNCER_SESSION_PORT=6323
PGBOUNCER_TRANSACTION_PORT=6324

# Deliberately lowered from Postgres's built-in default of 100. See README
# "Break it" for why: a low, fast-to-reach ceiling makes the direct-connection
# exhaustion scenario reliably reproducible in a couple of seconds without
# depending on host file-descriptor limits or spawning 150+ real OS processes.
POSTGRES_MAX_CONNECTIONS=30

# Direct-to-Postgres. Used for migrations, seeding, and the
# direct-connection-overhead scenario (which must bypass PgBouncer entirely).
DATABASE_URL=postgres://lab23:lab23@localhost:5423/lab23

# Through the session-pooling PgBouncer instance.
DATABASE_URL_PGBOUNCER_SESSION=postgres://lab23:lab23@localhost:6323/lab23

# Through the transaction-pooling PgBouncer instance.
DATABASE_URL_PGBOUNCER_TRANSACTION=postgres://lab23:lab23@localhost:6324/lab23

LOG_LEVEL=info
